{
  "opencollection": "1.0.0",
  "info": {
    "name": "SimilarWeb Batch Account Traffic and Engagement API",
    "version": "4.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Traffic and Engagement",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Visits - Desktop",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.similarweb.com/v1/website/:domain_name/traffic-and-engagement/visits",
            "params": [
              {
                "name": "domain_name",
                "value": "",
                "type": "path",
                "description": "Website domain without 'www.' prefix"
              },
              {
                "name": "api_key",
                "value": "",
                "type": "query",
                "description": "SimilarWeb API authentication key"
              },
              {
                "name": "country",
                "value": "",
                "type": "query",
                "description": "2-letter ISO 3166-1 alpha-2 country code or \"world\""
              },
              {
                "name": "granularity",
                "value": "",
                "type": "query",
                "description": "Temporal resolution for time series data"
              },
              {
                "name": "start_date",
                "value": "",
                "type": "query",
                "description": "Start month in YYYY-MM format"
              },
              {
                "name": "end_date",
                "value": "",
                "type": "query",
                "description": "End month in YYYY-MM format"
              },
              {
                "name": "main_domain_only",
                "value": "",
                "type": "query",
                "description": "Return main domain only (true) or include subdomains (false)"
              },
              {
                "name": "format",
                "value": "",
                "type": "query",
                "description": "Response format"
              },
              {
                "name": "mtd",
                "value": "",
                "type": "query",
                "description": "Month-to-date mode; use with daily granularity"
              },
              {
                "name": "state",
                "value": "",
                "type": "query",
                "description": "US state filter"
              }
            ]
          },
          "docs": "Retrieve estimated desktop website visits over time. Supports daily, weekly, and monthly granularity with up to 37 months of history."
        },
        {
          "info": {
            "name": "Bounce Rate - Desktop",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.similarweb.com/v1/website/:domain_name/traffic-and-engagement/bounce-rate",
            "params": [
              {
                "name": "domain_name",
                "value": "",
                "type": "path",
                "description": "Website domain without 'www.' prefix"
              },
              {
                "name": "api_key",
                "value": "",
                "type": "query",
                "description": "SimilarWeb API authentication key"
              },
              {
                "name": "country",
                "value": "",
                "type": "query",
                "description": "2-letter ISO 3166-1 alpha-2 country code or \"world\""
              },
              {
                "name": "granularity",
                "value": "",
                "type": "query",
                "description": "Temporal resolution for time series data"
              },
              {
                "name": "start_date",
                "value": "",
                "type": "query",
                "description": "Start month in YYYY-MM format"
              },
              {
                "name": "end_date",
                "value": "",
                "type": "query",
                "description": "End month in YYYY-MM format"
              },
              {
                "name": "main_domain_only",
                "value": "",
                "type": "query",
                "description": "Return main domain only (true) or include subdomains (false)"
              },
              {
                "name": "format",
